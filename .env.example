# Copia este archivo y llámalo .env (sin «.example»). Nunca subas el .env al repositorio ni compartas sus llaves.
# Donde dice «pendiente» puedes dejarlo así en la primera prueba.

PORT=3000
AMBIENTE=test

# ── Meta · WhatsApp (developers.facebook.com › tu app) ───────────────
# Configuración › Básica › «Clave secreta de la app»
WA_APP_SECRET=
# Una palabra que tú inventas; la escribes igual en Meta al configurar el webhook
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0
# Número «Conta Operación» (aprobaciones del operador). Primera prueba: pendiente
WA_CONTA_OP_PHONE_NUMBER_ID=pendiente
WA_CONTA_OP_TOKEN=pendiente
# Formularios (Flows). Primera prueba: pendiente
WA_FLOW_DATOS_ID=pendiente
WA_FLOW_CAMPO_ID=pendiente
WA_TEMPLATE_FACTURA=tu_factura_lista

# ── Facturapi (dashboard.facturapi.io) ─────────────────────────────────
# Solo hace falta si configuras el webhook de Facturapi. Primera prueba: pendiente
FACTURAPI_WEBHOOK_SECRET=pendiente
FACTURAPI_BASE_URL=https://www.facturapi.io/v2

# ── Claude (console.anthropic.com › API Keys) ─────────────────────────
ANTHROPIC_API_KEY=

# ── Conta ───────────────────────────────────────────────────────────
# Cualquier texto largo (16 letras o más) que inventes
RECEPTOR_SALT=
MIN_READ_CONFIDENCE=0.7
BOT_PAUSE_MINUTES=120
DEFAULT_PAYMENT_FORM=01

# ── Negocio de prueba ────────────────────────────────────────────────
DEMO_BUSINESS_NAME=Café Ámbar
# El RFC de tu organización de prueba en Facturapi
DEMO_BUSINESS_RFC=
DEMO_BUSINESS_TAX_SYSTEM=626
# Meta › WhatsApp › Configuración de la API › «Identificador del número de teléfono»
DEMO_WA_PHONE_NUMBER_ID=
# Meta › WhatsApp › Configuración de la API › «Token de acceso» (el temporal dura 24 h)
DEMO_WA_TOKEN=
# Tu celular con lada, sin «+» ni espacios (ej. 5215512345678). Opcional en la primera prueba
DEMO_OPERATOR_PHONE=
# Facturapi › tu organización › API Keys › «Test Key» (empieza con sk_test_)
DEMO_FACTURAPI_KEY=
